# Copy to .env (ignored by Git), or configure your hosting environment.
CHAT_ACCESS_PASSWORD=
ARK_API_KEY=

# Add the exact external origin before deploying behind an HTTPS reverse proxy.
# CHAT_PUBLIC_ORIGIN=https://chat.example.com
# CHAT_HOST=0.0.0.0
# PORT=4333

# Browser storage is the public demo default. Server storage is private legacy mode.
CHAT_STORAGE_MODE=browser
# Local only. Send Jev requests through the Chengdu–Singapore SSH relay.
# CHAT_JEV_RELAY=chengdu-singapore
# Shared role definitions only; visitor conversations and memories stay browser-local.
# CHAT_CATALOG_PATH=/var/lib/chat-lab/public-catalog.sqlite
